# Copiar a .env y rellenar. NUNCA commitear .env.
#   cp .env.example .env
#
# Generar secretos:
#   openssl rand -hex 32

# --- Zona horaria -------------------------------------------------------------
TZ=America/Bogota
APP_ENV=production
LOG_LEVEL=info

# --- Postgres -----------------------------------------------------------------
# Este usuario es dueño de las dos bases: 'mirror' (nuestra) y 'evolution'.
POSTGRES_USER=mirror
POSTGRES_PASSWORD=

# --- Evolution API ------------------------------------------------------------
# Equivale a la contraseña de TODAS las líneas de WhatsApp de la agencia.
# Quien la tenga puede leer y enviar por cualquier número conectado.
EVOLUTION_API_KEY=
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_LOG_LEVEL=ERROR,WARN,INFO

# --- Puertos publicados en el host --------------------------------------------
BACKEND_PORT=8090
WEB_PORT=3000

# --- URLs públicas ------------------------------------------------------------
# En producción: https://panel.agencia.com y wss://api.agencia.com
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8090
PUBLIC_WS_URL=ws://localhost:8090

# --- Concurrencia del backend -------------------------------------------------
# WORKER_SHARDS: goroutines de proceso. Cada conversación queda fijada a un shard,
# así que subirlo aumenta el paralelismo ENTRE chats sin romper el orden dentro de
# cada uno. Regla práctica: número de líneas conectadas, mínimo 4.
WORKER_SHARDS=8
# Buffer por shard. Al llenarse, el handler devuelve 503 y Evolution reintenta.
WORKER_QUEUE_SIZE=512
MEDIA_WORKERS=4

# --- Cloudflare R2 ------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=whatsapp-media
# Vida de las URLs firmadas que sirve el backend. Corta a propósito: aquí viajan
# pasaportes.
R2_SIGNED_URL_TTL=15m

# --- Auth del panel -----------------------------------------------------------
JWT_SECRET=
JWT_TTL=12h
