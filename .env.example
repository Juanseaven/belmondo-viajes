# Copiar a .env y rellenar. NUNCA commitear .env.
#   cp .env.example .env
#
# Generar secretos:
#   openssl rand -hex 32

# --- Zona horaria -------------------------------------------------------------
TZ=America/Bogota
APP_ENV=production
LOG_LEVEL=info

# --- Postgres -----------------------------------------------------------------
# Este usuario es dueño de 'mirror', 'evogo_auth' y 'evogo_users'.
POSTGRES_USER=mirror
POSTGRES_PASSWORD=

# --- Evolution Go -------------------------------------------------------------
# Equivale a la contraseña de TODAS las líneas de WhatsApp de la agencia.
# Quien la tenga puede leer y enviar por cualquier número conectado.
EVOLUTION_API_KEY=
EVOLUTION_LOG_LEVEL=INFO
# Email usado para activar la licencia comunitaria de Evolution Go.
EVOLUTION_OPERATOR_EMAIL=

# --- Puertos publicados en el host --------------------------------------------
BACKEND_PORT=8090
WEB_PORT=3000

# --- URLs públicas ------------------------------------------------------------
# En producción: https://panel.agencia.com y wss://api.agencia.com
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8090
PUBLIC_WS_URL=ws://localhost:8090

# --- Concurrencia del backend -------------------------------------------------
# WORKER_SHARDS: goroutines de proceso. Cada conversación queda fijada a un shard,
# así que subirlo aumenta el paralelismo ENTRE chats sin romper el orden dentro de
# cada uno. Regla práctica: número de líneas conectadas, mínimo 4.
WORKER_SHARDS=8
# Buffer por shard. Al llenarse, el handler devuelve 503 y Evolution reintenta.
WORKER_QUEUE_SIZE=512
MEDIA_WORKERS=4

# --- Retención ----------------------------------------------------------------
# Días que se conservan los webhooks ya procesados. El módulo espejo los purga
# solo, una vez al día. La tabla guarda el payload completo de CADA evento —los
# ACK de entrega y lectura incluidos, que multiplican el volumen de mensajes—, así
# que sin purga crece del orden de millones de filas al mes: el síntoma no es que
# consulte lento, es el disco lleno. 0 desactiva la purga.
EVENT_RETENTION_DAYS=30

# --- Almacenamiento de archivos -----------------------------------------------
# Los adjuntos NO viajan en el webhook de WhatsApp: llega una URL cifrada y hay
# que pedirle el archivo a Evolution para guardarlo en algún lado.
#
# DEJÁ ESTO VACÍO para empezar: sin credenciales de R2 los archivos se guardan en
# el disco del contenedor (volumen `blobs`), que alcanza para desarrollo y para
# un despliegue de una sola máquina. Todo funciona igual, incluidas las URLs
# firmadas de vida corta.
#
# O las cuatro variables o ninguna: el backend rechaza una configuración a
# medias, porque tres de cuatro arrancaría en local sin que nadie se entere.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Vida de las URLs firmadas, con R2 y en local. Corta a propósito: por acá viajan
# documentos de identidad de los clientes.
R2_SIGNED_URL_TTL=15m

# --- Auth del panel -----------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=
JWT_TTL=12h

# Administrador inicial. Solo se usa si la tabla `users` está vacía: sin él no hay
# forma de entrar la primera vez, porque no existe registro público y crear
# usuarios exige ya ser admin.
#
# Una vez creado el usuario, cambiá la contraseña desde el panel y borrá estas dos
# líneas del .env: no tiene sentido dejar una contraseña en claro en el servidor.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
